# ============================================================
# Shop Manager — environment
#
# NAMES ONLY. Every value below is blank on purpose: this file is
# committed, and a file that can hold a real key eventually holds one.
# Copy it to .env (which .gitignore already excludes) and fill in only
# what you actually use.
#
# THE APP RUNS WITH NONE OF THESE SET. A shop PC needs nothing here —
# the database is local, backups are local, and a session secret is
# generated into data/session-secret.txt on first boot. Everything below
# turns on something optional, or replaces a local default with a hosted
# one.
#
# Anything marked SECRET must never reach a browser, a log, a backup, a
# git commit or an API response. If one ever does, treat it as burnt:
# rotate it at the source first, then change it here.
# ============================================================

# ---- where the data lives -----------------------------------
# Absolute path to the folder holding the databases, backups, session
# store and keys. Defaults to ./data. On a hosted copy this should point
# at a MOUNTED DISK, or every redeploy starts from an empty shop.
DATA_DIR=

# Port to listen on. Defaults to 3000.
PORT=

# Set to "production" to turn on secure cookies and HSTS. Leave unset
# when developing over plain http://localhost, or you cannot log in.
NODE_ENV=

# IANA timezone, e.g. Asia/Kolkata. Affects which day a bill lands on.
TZ=


# ---- sessions -----------------------------------------------
# SECRET. Signs the session cookie. At least 32 characters; the app
# refuses to start if it is set and shorter than that.
# Leave BLANK on a shop PC: one is generated and kept in
# data/session-secret.txt. Set it on a hosted copy so the secret lives
# in the platform's secret store instead of on a disk, and so two
# instances agree about a cookie.
# CHANGING IT SIGNS EVERYONE OUT. That is the correct response to a leak.
SESSION_SECRET=


# ---- off-site backup: Supabase Storage ----------------------
# Optional. See data/.env.example for the step-by-step setup.
# SUPABASE_KEY is the service_role key: SECRET, server-side only.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=


# ---- off-site backup: Cloudflare R2 -------------------------
# Optional alternative to Supabase. Both secrets below are SECRET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=


# ---- licensing ----------------------------------------------
# Where this copy checks its licence. Leave blank for the default.
LICENCE_SERVER=
# SECRET-ish: identifies this installation to the licence server.
LICENSE_KEY=
ACTIVATION_CODE=
# "1" turns on multi-tenant mode, where one installation serves several
# shops and each session is pinned to its own company.
MULTI_TENANT=


# ---- GST / e-way bill ---------------------------------------
# "sandbox" or "production". Provider credentials are NOT set here —
# they are entered in the app and stored encrypted under the key in
# data/credential-key.txt, which deliberately sits outside the database
# so a stolen backup decrypts to nothing.
GST_ENV=
EWB_PROVIDER=


# ---- Tally bridge -------------------------------------------
# SECRET. Shared token between the shop PC's Tally bridge and the app.
BRIDGE_TOKEN=


# ---- bill scanning ------------------------------------------
# SECRET. Only needed if reading a photo of a supplier bill into a draft
# purchase. Never sent to a browser.
ANTHROPIC_API_KEY=


# ---- printing (Windows shop PC) ------------------------------
PRINTER_NAME=
SUMATRA_PATH=
