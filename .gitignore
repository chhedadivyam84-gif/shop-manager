node_modules/
data/*.db
data/*.db-*
data/session-secret.txt
data/.env

# Any environment file, anywhere. A credentials file that can be committed
# is a credentials file that eventually is — and rotating a key because it
# reached a repository is how this rule got written.
.env
.env.*
!.env.example
*/.env
data/reset-log.txt
npm-debug.log
backups/
print-archive/
data/tools/

# Per-install business registry: which businesses exist on THIS machine.
# It must never travel through git, or a deploy would overwrite the
# server's own list with the developer's.
data/companies.json
data/companies/
