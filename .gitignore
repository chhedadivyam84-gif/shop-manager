node_modules/
data/*.db
data/*.db-*
data/session-secret.txt
# The key that GST/e-way bill credentials are encrypted under. It lives
# beside the database and NOT inside it, which is the entire point: the
# cloud backup uploads shop-*.db only, so a stolen backup decrypts to
# nothing. A key in the repository would undo that in one commit.
data/credential-key.txt
data/.env

# Any environment file, anywhere. A credentials file that can be committed
# is a credentials file that eventually is — and rotating a key because it
# reached a repository is how this rule got written.
.env
.env.*
!.env.example
*/.env
data/reset-log.txt
npm-debug.log
backups/
print-archive/
data/tools/

# Per-install business registry: which businesses exist on THIS machine.
# It must never travel through git, or a deploy would overwrite the
# server's own list with the developer's.
data/companies.json
data/companies/

# TallyPrime writes its own request logs into whatever folder it runs from.
# They are Tally's, not this app's, and they grow with every sync.
tallyhttp.log
tdlfunc.log

# The bridge config holds the token the shop PC authenticates with. Same
# rule as every other credential here: a file that can be committed is one
# that eventually is.
tools/tally-bridge.json
