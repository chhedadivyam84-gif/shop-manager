# ============================================================
# Optional cloud backup — Supabase Storage
# ------------------------------------------------------------
# The app works fully WITHOUT this. Local rotating backups run
# regardless. Fill this in only if you also want an off-site
# copy pushed to your own free Supabase project, so a lost or
# broken shop PC doesn't take your records with it.
#
# SETUP (one time, ~5 minutes):
#   1. Make a free account at https://supabase.com and create a
#      project (any name/region near you).
#   2. In the project: Storage -> New bucket -> name it
#      "shop-backups". Leave it PRIVATE (do not make it public).
#   3. Project Settings -> API. Copy:
#        - "Project URL"        -> SUPABASE_URL below
#        - "service_role" key   -> SUPABASE_KEY below
#      (The service_role key can write to storage. It stays on
#      this PC only and is never sent to any browser. Keep it
#      secret — anyone with it can read/write your project.)
#   4. Rename this file from ".env.example" to ".env" (same
#      folder) and paste your values in.
#   5. Restart the app (pm2 restart shop-manager). Settings ->
#      Backup should now show "Cloud backup on".
# ============================================================

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_KEY=YOUR-service_role-key
SUPABASE_BUCKET=shop-backups
